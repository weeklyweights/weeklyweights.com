---
// One layout, tiny CSS, system fonts, both colour schemes. Budget: the whole
// page in tens of kilobytes. No webfonts, no framework JS, no trackers.
interface Props { title: string; description?: string }
const { title, description = 'Plain-language generative-AI learning for people in any job.' } = Astro.props;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="color-scheme" content="light dark" />
  <meta name="description" content={description} />
  <title>{title} · Weekly Weights</title>
  <style>
    :root{--bg:#f7f4ec;--ink:#221c14;--muted:#6b6250;--line:#dcd0ae;--accent:#b0551e}
    @media (prefers-color-scheme:dark){:root{--bg:#15120c;--ink:#ece4d2;--muted:#a89a7d;--line:#362f1e;--accent:#e08847}}
    *{box-sizing:border-box}
    body{margin:0;background:var(--bg);color:var(--ink);font:17px/1.6 Georgia,"Times New Roman",serif}
    header,main,footer{max-width:42rem;margin:0 auto;padding:0 1.25rem}
    header{padding-top:1.5rem;border-bottom:2px solid var(--ink);margin-bottom:1.5rem}
    header a{color:inherit;text-decoration:none;font-style:italic;font-size:1.5rem;font-weight:600}
    header small{display:block;color:var(--muted);font:12px/1.5 ui-monospace,Menlo,monospace;text-transform:uppercase;letter-spacing:.08em;margin:.25rem 0 1rem}
    h1,h2,h3{line-height:1.25;text-wrap:balance}
    a{color:var(--accent)}
    .muted{color:var(--muted)}
    .mono{font:13px/1.5 ui-monospace,Menlo,monospace}
    ul.list{padding-left:1.1rem}
    footer{margin-top:3rem;padding:1rem 1.25rem 3rem;border-top:1px solid var(--line);color:var(--muted);font-size:.9rem}
  </style>
</head>
<body>
  <header>
    <a href="/">Weekly Weights</a>
    <small>Learn what AI actually is · free tools only · works on any phone</small>
  </header>
  <main><slot /></main>
  <footer>
    <p>Written in plain language, kept current weekly, and honest about what is uncertain. Nothing here requires a paid subscription.</p>
  </footer>
</body>
</html>
